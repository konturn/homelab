# Keeps the GitLab restore-point mirror warm so an upgrade's offline copy is
# only the delta (docs/AUTOMERGE.md, "GitLab updates").
[Unit]
Description=Refresh the GitLab restore-point mirror
After=docker.service

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/usr/bin/python3 /usr/local/sbin/gitlab-oob-upgrade --warm
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=4h
SyslogIdentifier=gitlab-oob
