# Out-of-band GitLab upgrades (docs/AUTOMERGE.md, "GitLab updates").
# Installed by ansible (configure-homelab-services); started by the timer.
[Unit]
Description=Out-of-band GitLab upgrade (restore point, health gate, rollback)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/usr/bin/python3 /usr/local/sbin/gitlab-oob-upgrade
# A first restore point copies ~75 GB at 40 MB/s; the health gate allows 30 min.
TimeoutStartSec=4h
SyslogIdentifier=gitlab-oob
