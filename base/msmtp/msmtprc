# System-wide msmtp configuration
defaults
auth           on
tls            on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile        /var/log/msmtp.log
# Rewrite bare local recipients (root, cron MAILTO) to a deliverable address.
aliases        /etc/aliases

account        gmail
host           smtp.gmail.com
port           587
from           konoahko@gmail.com
user           konoahko@gmail.com
password       {{ (vault_gmail_app_password | default(lookup('env', 'GMAIL_APP_PASSWORD'), true)) | trim }}

account default : gmail
