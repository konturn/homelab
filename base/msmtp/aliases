# msmtp alias map — maps local (unqualified) recipients to a real mailbox.
# Referenced by the `aliases` line in /etc/msmtprc; installed to
# /etc/msmtp-aliases, NOT /etc/aliases (see the role task for why).
#
# System daemons mail their local superuser account by name, not by address:
# smartd defaults to `-m root`, and cron mails MAILTO/root. msmtp hands the
# recipient to Gmail verbatim, and Gmail rejects a bare local part:
#   553 5.1.3 The recipient address <root> is not a valid RFC 5321 address
#   -> msmtp "could not send mail", sendmail exit 65
#
# smartmontools.service hit this on every run for at least 29 days — the full
# Loki retention window, so the true start date is unknown — while sdb
# (CT480BX500SSD1) and sdk (WDC WD240KFGX) sit flagged for pre-failure
# sectors (#136). The channel whose whole job is warning about dying disks was
# failing silently, once a day.
#
# Only recipients with no '@' are rewritten, so anything already addressed to
# a real mailbox (restic's notifier, for example) is untouched — this cannot
# regress mail that currently works.
root: konoahko@gmail.com

# Catch-all for any other local sender — cron, mdadm, apt, logwatch. Without a
# default, an unmatched local address is passed through unchanged and is
# rejected exactly the way `root` is now.
default: konoahko@gmail.com
