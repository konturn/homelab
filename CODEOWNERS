# CODEOWNERS — Privilege escalation prevention
# 
# moltbot (Prometheus) has Maintainer access and can self-merge MRs.
# These rules require approval from @root for paths that could be
# used to escalate privileges, bypass security controls, or break
# remote access.
#
# Philosophy: moltbot can freely modify application configs, docs,
# and non-sensitive infrastructure. But anything that could grant
# it more access, break network connectivity, or run arbitrary
# code on hosts requires human approval.

# === NETWORK & FIREWALL ===
# Could open ports, grant network access, break remote connectivity
/networking/iptables/                    @root
/networking/networkd/                    @root
/networking/netplan/                     @root
/networking/wireguard/                   @root
/networking/dhcp/                        @root

# === SSH & REMOTE ACCESS ===
# Could add SSH keys, modify access controls
/ansible/known_hosts                     @root
/base/systemd/                           @root

# === ANSIBLE INFRASTRUCTURE ===
# All Ansible content executes as root on hosts — protect everything
/ansible/                                @root

# === CI PIPELINE ===
# Could run arbitrary commands during CI, exfiltrate secrets
/.gitlab-ci.yml                          @root

# The runner config is a superset of the .gitlab-ci.yml gate above: it decides
# what every CI container is allowed to be, so it can grant anything that file
# could ask for. It is templated to /etc/gitlab-runner/config.toml on the router
# as root (ansible/roles/configure-base/tasks/main.yml, "Gitlab runner config
# file"), and today it sets privileged, network_mode = "host", the host volume
# mounts (incl. the docker-proxy TLS client certs) and the environment applied to
# every job. Flipping privileged to true, mounting / or the vault data dir, or
# adding an env var reaches the host without ever touching a gated path.
# Ungated until 2026-09-29 while /.gitlab-ci.yml, /base/systemd/ and /ansible/
# all were gated, which made the CI gate bypassable from an unreviewed file.
# It also carries the memory/memory_swap blast-radius ceiling for build jobs.
/base/gitlab-runner/                     @root

# === TELEGRAF ===
# Exec plugins run arbitrary scripts on the host as telegraf user
# (which has sudo access to smartctl, granted in
# /etc/sudoers.d/telegraf-smartctl). Protect scripts and config.
#
# The path is /docker/telegraf/. This rule read /base/telegraf/ until
# 2026-09-22 and that directory has never existed, so the rule matched
# nothing: telegraf.conf (3 [[inputs.exec]] blocks) and scripts/ were
# self-mergeable by moltbot the whole time. The files are templated to
# /etc/telegraf/ on the router by the docker_config entries in
# ansible/inventory.yml, so a change here runs on the host.
/docker/telegraf/                        @root

# === DOCKER COMPOSE ===
# Could mount host paths, add privileged containers, modify any service
# This is the big one — compose controls everything
/docker/docker-compose.yml               @root
/docker/docker-compose-*.yml             @root
/docker/daemon.json                      @root

# === MOLTBOT SELF-MODIFICATION ===
# Prevent moltbot from expanding its own access
/docker/openclaw/                         @root

# === VAULT & SECRETS ===
# Could access or redirect secret storage
/docker/vault/                           @root
/docker/jit-approval-svc/                @root
/terraform/vault/                        @root

# === SSL CERTS ===
# Could intercept TLS traffic
/networking/ssl/                         @root

# === THIS FILE ===
# Prevent moltbot from removing its own restrictions
/CODEOWNERS                              @root

