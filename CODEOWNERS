# CODEOWNERS — Privilege escalation prevention
# 
# moltbot (Prometheus) has Developer access, which can merge MRs to main
# (protected branch: Developers + Maintainers may merge).
# These rules require approval from @root for paths that could be
# used to escalate privileges, bypass security controls, or break
# remote access.
#
# Philosophy: moltbot can freely modify application configs, docs,
# and non-sensitive infrastructure. But anything that could grant
# it more access, break network connectivity, or run arbitrary
# code on hosts requires human approval.

# === NETWORK & FIREWALL ===
# Could open ports, grant network access, break remote connectivity
/networking/iptables/                    @root
/networking/networkd/                    @root
/networking/netplan/                     @root
/networking/wireguard/                   @root
/networking/dhcp/                        @root

# === SSH & REMOTE ACCESS ===
# Could add SSH keys, modify access controls
/ansible/known_hosts                     @root
/base/systemd/                           @root

# === ANSIBLE INFRASTRUCTURE ===
# All Ansible content executes as root on hosts — protect everything
/ansible/                                @root

# === CI PIPELINE ===
# Could run arbitrary commands during CI, exfiltrate secrets
/.gitlab-ci.yml                          @root

# GitLab runner config: templated to /etc/gitlab-runner/config.toml on the
# router (configure-base). Sets the executor options, volumes and environment
# for every CI job.
/base/gitlab-runner/                     @root

# === TELEGRAF ===
# Exec plugins run arbitrary scripts on the host as telegraf user
# (which has sudo access to smartctl). Protect scripts and config.
# Templated from docker/telegraf/ to /etc/telegraf/ (ansible/inventory.yml).
/docker/telegraf/                        @root

# === DOCKER COMPOSE ===
# Could mount host paths, add privileged containers, modify any service
# This is the big one — compose controls everything
# The second owner is the auto-merge bot (AUTOMERGE_TOKEN project bot). It
# approves moltbot/Renovate MRs only via the automerge:sweep job on main, for
# MRs that pass ci/automerge/policy.py. Root-authored MRs (root cannot approve
# its own) get its approval via scripts/approve-root-mr.sh, which refuses any
# other author. See docs/AUTOMERGE.md.
/docker/docker-compose.yml               @root @project_4_bot_9927c1d39b8f3ba11b15bfa664d8b6d6
/docker/docker-compose-*.yml             @root
/docker/daemon.json                      @root

# === MOLTBOT SELF-MODIFICATION ===
# Prevent moltbot from expanding its own access
/docker/openclaw/                         @root
# Reviewed instructions and lessons loaded into every agent session.
# Covered by the rule above; listed explicitly so it stays protected if
# that rule is ever narrowed.
/docker/openclaw/workspace/               @root

# === REVERSE PROXIES, BROWSER, LOG SHIPPING, TERRAFORM ===
# nginx vhosts decide which services are reachable and from where; the
# chromium-browser image is the agent's browser; promtail ships logs to Loki;
# terraform manages infrastructure state.
/docker/nginx/                           @root
/docker/chromium-browser/                @root
/docker/promtail/                        @root
/terraform/                              @root

# === VAULT & SECRETS ===
# Could access or redirect secret storage
/docker/vault/                           @root
/docker/jit-approval-svc/                @root
# Anomaly detector signals and suppressions: the OpenClaw agent proposes
# suppressions by MR; Noah approves them.
/docker/anomaly-detector/                @root
/terraform/vault/                        @root

# === SSL CERTS ===
# Could intercept TLS traffic
/networking/ssl/                         @root

# === AUTO-MERGE POLICY ===
# Defines which MRs may merge and deploy without review (docs/AUTOMERGE.md)
/ci/                                     @root

# === THIS FILE ===
# Prevent moltbot from removing its own restrictions
/CODEOWNERS                              @root

