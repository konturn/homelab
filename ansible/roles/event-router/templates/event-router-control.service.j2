# {{ ansible_managed }}
# Kill switch on Telegram and the router's messages to Noah, through the JIT
# service's action-prompt socket (docker/event-router/README.md).
[Unit]
Description=Event router control (Telegram kill switch, notifications)
After=docker.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/event-router-control
SyslogIdentifier=event-router-control
Restart=always
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
