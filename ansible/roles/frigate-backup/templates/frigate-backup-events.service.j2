# {{ ansible_managed }}
# Offsite backup of Frigate, events (docs/frigate.md, "Backup")
[Unit]
Description=Frigate restic backup (events)
After=network-online.target
Wants=network-online.target
OnFailure=restic-notify-failure@%n.service

[Service]
Type=oneshot
User=root
# Batch work: yield CPU to core services (CLAUDE.md "CPU priority").
# CPUWeight works across cgroups; Nice only orders processes inside this unit.
CPUWeight=20
Nice=19
IOSchedulingClass=idle
CPUQuota={{ 8 * ansible_processor_vcpus }}%
TimeoutStartSec={{ frigate_backup_events_timeout }}
EnvironmentFile=/root/.restic_env
ExecStart=/usr/local/sbin/frigate-backup events
