[Unit]
Description=Restic prune
After=network-online.target
Wants=network-online.target
OnFailure=restic-notify-failure@%n.service

[Service]
Type=oneshot
User={{ restic_user }}

CPUQuota={{ 25 * ansible_processor_vcpus }}%
Nice=19
IOSchedulingClass=idle

EnvironmentFile={{ restic_user_home }}/.restic_env

ExecStart={{ restic_path }} prune --retry-lock {{ restic_prune_retry_lock }}
