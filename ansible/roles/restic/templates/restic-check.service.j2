[Unit]
Description=Restic repository integrity check
After=network-online.target
Wants=network-online.target
OnFailure=restic-notify-failure@%n.service

[Service]
Type=oneshot
User={{ restic_user }}

CPUQuota={{ 25 * ansible_processor_vcpus }}%
# Batch work: yield CPU to core services (CLAUDE.md "CPU priority").
# CPUWeight works across cgroups; Nice only orders processes inside this unit.
CPUWeight=20
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

EnvironmentFile=/root/.restic_env

ExecStart={{ restic_path }} check --read-data-subset={{ restic_check_read_data_subset }} --retry-lock {{ restic_check_retry_lock }}
