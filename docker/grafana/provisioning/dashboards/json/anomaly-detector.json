{
  "uid": "anomaly-detector",
  "title": "Anomaly detector",
  "tags": [
    "anomaly",
    "homelab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Severe (active)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"metrics\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"anomaly\" and r.severity == \"severe\" and r.suppressed == \"false\" and r._field == \"anomalous\")\n  |> group(columns: [\"signal\", \"check\", \"series\"])\n  |> last()\n  |> group()\n  |> count()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Moderate (active)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"metrics\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"anomaly\" and r.severity == \"moderate\" and r.suppressed == \"false\" and r._field == \"anomalous\")\n  |> group(columns: [\"signal\", \"check\", \"series\"])\n  |> last()\n  |> group()\n  |> count()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Detector cycle (s)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"metrics\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"anomaly_detector\" and r._field == \"cycle_seconds\")\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Query errors",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"metrics\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"anomaly_detector\" and r._field == \"errors\")\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "-",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Current anomalies (incl. suppressed)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"metrics\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"anomaly\" and r.severity != \"ok\")\n  |> filter(fn: (r) => r._field == \"score\" or r._field == \"value\" or r._field == \"baseline\")\n  |> group(columns: [\"signal\", \"check\", \"series\", \"severity\", \"suppressed\", \"category\", \"_field\"])\n  |> last()\n  |> group()\n  |> pivot(rowKey: [\"signal\", \"check\", \"series\", \"severity\", \"suppressed\", \"category\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"severity\", \"category\", \"signal\", \"series\", \"check\", \"value\", \"baseline\", \"score\", \"suppressed\"])\n  |> sort(columns: [\"severity\", \"signal\"], desc: true)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "severe": {
                        "color": "red",
                        "index": 0
                      },
                      "moderate": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Anomalous score by signal (|z| or exceedance, anomalous evaluations only)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "import \"math\"\nfrom(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"anomaly\" and r._field == \"score\" and r.severity != \"ok\")\n  |> map(fn: (r) => ({r with _value: math.abs(x: r._value)}))\n  |> group(columns: [\"signal\", \"series\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "points",
            "pointSize": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max"
          ]
        }
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Anomalous minutes per signal (time range)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"anomaly\" and r._field == \"anomalous\" and r._value == 1)\n  |> group(columns: [\"signal\", \"severity\"])\n  |> count()\n  |> map(fn: (r) => ({r with _value: r._value * 5}))\n  |> group()\n  |> keep(columns: [\"signal\", \"severity\", \"_value\"])"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xField": "signal"
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Detector: cycle seconds and series evaluated",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"anomaly_detector\")\n  |> filter(fn: (r) => r._field == \"cycle_seconds\" or r._field == \"series\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}