    {
      "id": 13,
      "type": "stat",
      "title": "Current mode",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Effective kill-switch mode from the newest mode_changed or started line.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "expr": "{container=\"event-router\"} | json | __error__=\"\" | decision=~\"mode_changed|started\" | line_format \"{{.mode}}\"",
          "maxLines": 1
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "firstNotNull"
          ],
          "fields": "/^Line$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "unknown",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "active": {
                  "color": "green",
                  "index": 0
                },
                "shadow": {
                  "color": "orange",
                  "index": 1
                },
                "notify-only": {
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
