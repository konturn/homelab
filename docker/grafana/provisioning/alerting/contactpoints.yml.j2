{% raw %}
apiVersion: 1

contactPoints:
  - orgId: 1
    name: homelab-email-alerts
    receivers:
      - uid: homelab-email-alerts
        type: email
        settings:
          addresses: "konoahko@gmail.com"
          subject: "🚨 Homelab Alert: {{ .GroupLabels.alertname | title }}"
          message: |
            **Alert**: {{ .GroupLabels.alertname }}
            **Severity**: {{ .CommonLabels.severity }}
            **Summary**: {{ range .Alerts }}{{ .Annotations.summary }}{{ end }}
            
            **Details**:
            {{ range .Alerts }}
            - **Status**: {{ .Status }}
            - **Description**: {{ .Annotations.description }}
            - **Labels**: {{ range .Labels.SortedPairs }}{{ .Name }}={{ .Value }} {{ end }}
            {{ if .GeneratorURL }}
            - **Dashboard**: {{ .GeneratorURL }}
            {{ end }}
            {{ end }}
            
            Time: {{ .CommonAnnotations.startsAt }}
        disableResolveMessage: false
  - orgId: 1
    name: openclaw-webhook
    receivers:
      - uid: openclaw-webhook
        type: webhook
        settings:
          url: "http://openclaw-gateway:18789/hooks/grafana"
          httpMethod: POST
          authorization_scheme: Bearer
{% endraw %}
          authorization_credentials: "{{ vault_openclaw_hooks_token }}"
        disableResolveMessage: false
  # Event router (docs/design/event-routing.md): every alert, one per
  # notification (policies.yml), firing and resolved. Phases 1-2: in addition
  # to openclaw-webhook and email, which are unchanged.
  - orgId: 1
    name: event-router
    receivers:
      - uid: event-router
        type: webhook
        settings:
          url: "http://event-router:8080/grafana"
          httpMethod: POST
          authorization_scheme: Bearer
          authorization_credentials: "{{ vault_event_router_grafana_token }}"
        disableResolveMessage: false
