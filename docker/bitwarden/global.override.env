## SMTP Configuration
## These only apply while /data/config.json has no smtp_* keys; the
## configure-homelab-services role strips any the admin panel saves.
SMTP_HOST=smtp.gmail.com
SMTP_FROM=konoahko@gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=konoahko@gmail.com
SMTP_PASSWORD={{ vault_gmail_app_password | trim | replace("$", "$$") }}

## Accounts are created by the admin (invitations); no self-service sign-up.
## Note: /data/config.json (admin panel settings) overrides env vars; the
## configure-homelab-services role keeps signups_allowed=false there too.
SIGNUPS_ALLOWED=false
