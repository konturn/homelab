# paperless-ai configuration, rendered by ansible (docker_config) and mounted
# read-only at /app/data/.env: the web UI cannot change it. See
# docs/paperless-ai.md. homelab-config-check (paperless-ai-env) refuses any
# provider other than the local Ollama and any cloud API key.
PAPERLESS_API_URL=http://paperless-ngx:8000/api
PAPERLESS_API_TOKEN={{ vault_paperless_ai_paperless_token }}
PAPERLESS_USERNAME=paperless-ai
AI_PROVIDER=ollama
OLLAMA_API_URL=http://ollama:11434
OLLAMA_MODEL=paperless-qwen3:14b
# Review mode: only documents tagged paperless-ai-test are processed, and
# each one gets the ai-processed tag. New documents are not touched.
PROCESS_PREDEFINED_DOCUMENTS=yes
TAGS=paperless-ai-test
ADD_AI_PROCESSED_TAG=yes
AI_PROCESSED_TAG_NAME=ai-processed
DISABLE_AUTOMATIC_PROCESSING=no
SCAN_INTERVAL=*/30 * * * *
USE_EXISTING_DATA=yes
USE_PROMPT_TAGS=no
PROMPT_TAGS=
ACTIVATE_TAGGING=yes
ACTIVATE_CORRESPONDENTS=yes
ACTIVATE_DOCUMENT_TYPE=yes
ACTIVATE_TITLE=yes
ACTIVATE_CUSTOM_FIELDS=no
CUSTOM_FIELDS={"custom_fields":[]}
# num_ctx = prompt + 1024, capped here: bounds VRAM next to Plex.
TOKEN_LIMIT=8192
RESPONSE_TOKENS=1000
CONTENT_MAX_LENGTH=16000
SYSTEM_PROMPT=
API_KEY={{ vault_paperless_ai_api_key }}
JWT_SECRET={{ vault_paperless_ai_jwt_secret }}
PAPERLESS_AI_INITIAL_SETUP=yes
