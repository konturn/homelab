[Unit]
Description=Re-apply edge-quarantine state (nginx maintenance map, port rules)
Documentation=file:///usr/local/sbin/edge-quarantine
After=network-online.target netfilter-persistent.service docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/edge-quarantine --json render

[Install]
WantedBy=multi-user.target
